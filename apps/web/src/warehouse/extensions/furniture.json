{
  "format": "opencalque-extension",
  "formatVersion": 1,
  "id": "opencalque.furniture",
  "name": "Adjustable furniture",
  "version": "1.1.0",
  "author": "OpenCalque",
  "description": "Tables, beds and shelving whose size and number of seats or bays you set.",
  "translations": {
    "fr": {
      "Adjustable furniture": "Mobilier ajustable",
      "Tables, beds and shelving whose size and number of seats or bays you set.": "Tables, lits et étagères dont vous réglez la taille et le nombre de places ou de travées.",
      "Table with chairs": "Table avec chaises",
      "Bed": "Lit",
      "Shelving unit": "Étagère",
      "Length": "Longueur",
      "Width": "Largeur",
      "Depth": "Profondeur",
      "Seats": "Places",
      "Bays": "Travées"
    },
    "es": {
      "Adjustable furniture": "Mobiliario ajustable",
      "Tables, beds and shelving whose size and number of seats or bays you set.": "Mesas, camas y estanterías cuyo tamaño y número de plazas o módulos usted define.",
      "Table with chairs": "Mesa con sillas",
      "Bed": "Cama",
      "Shelving unit": "Estantería",
      "Length": "Longitud",
      "Width": "Ancho",
      "Depth": "Fondo",
      "Seats": "Plazas",
      "Bays": "Módulos"
    },
    "de": {
      "Adjustable furniture": "Anpassbare Möbel",
      "Tables, beds and shelving whose size and number of seats or bays you set.": "Tische, Betten und Regale, deren Größe und Anzahl der Plätze oder Felder Sie festlegen.",
      "Table with chairs": "Tisch mit Stühlen",
      "Bed": "Bett",
      "Shelving unit": "Regal",
      "Length": "Länge",
      "Width": "Breite",
      "Depth": "Tiefe",
      "Seats": "Plätze",
      "Bays": "Felder"
    },
    "zh": {
      "Adjustable furniture": "可调家具",
      "Tables, beds and shelving whose size and number of seats or bays you set.": "可设置尺寸及座位数或格数的桌子、床和置物架。",
      "Table with chairs": "桌椅",
      "Bed": "床",
      "Shelving unit": "置物架",
      "Length": "长度",
      "Width": "宽度",
      "Depth": "深度",
      "Seats": "座位数",
      "Bays": "格数"
    },
    "ja": {
      "Adjustable furniture": "サイズ可変の家具",
      "Tables, beds and shelving whose size and number of seats or bays you set.": "サイズや席数・棚の数を設定できるテーブル、ベッド、棚。",
      "Table with chairs": "テーブルといす",
      "Bed": "ベッド",
      "Shelving unit": "棚",
      "Length": "長さ",
      "Width": "幅",
      "Depth": "奥行き",
      "Seats": "席数",
      "Bays": "棚の数"
    }
  },
  "objects": [
    {
      "kind": "furn.table",
      "category": "furniture",
      "label": "Table with chairs",
      "params": [
        { "key": "length", "label": "Length", "type": "number", "default": 1800, "unit": "length" },
        { "key": "width", "label": "Width", "type": "number", "default": 900, "unit": "length" },
        { "key": "seats", "label": "Seats", "type": "number", "default": 6 }
      ],
      "box": { "width": "length", "height": "width" },
      "draw": [
        { "closed": true, "path": [[0, 0], ["length", 0], ["length", "width"], [0, "width"]] },
        {
          "repeat": { "count": "max(1, floor(seats / 2))" },
          "closed": true,
          "path": [
            ["(i + 0.5) * length / max(1, floor(seats / 2)) - 225", -450],
            ["(i + 0.5) * length / max(1, floor(seats / 2)) + 225", -450],
            ["(i + 0.5) * length / max(1, floor(seats / 2)) + 225", -50],
            ["(i + 0.5) * length / max(1, floor(seats / 2)) - 225", -50]
          ]
        },
        {
          "repeat": { "count": "max(1, floor(seats / 2))" },
          "closed": true,
          "path": [
            ["(i + 0.5) * length / max(1, floor(seats / 2)) - 225", "width + 50"],
            ["(i + 0.5) * length / max(1, floor(seats / 2)) + 225", "width + 50"],
            ["(i + 0.5) * length / max(1, floor(seats / 2)) + 225", "width + 450"],
            ["(i + 0.5) * length / max(1, floor(seats / 2)) - 225", "width + 450"]
          ]
        }
      ]
    },
    {
      "kind": "furn.bed",
      "category": "furniture",
      "label": "Bed",
      "params": [
        { "key": "width", "label": "Width", "type": "number", "default": 1600, "unit": "length" },
        { "key": "length", "label": "Length", "type": "number", "default": 2000, "unit": "length" }
      ],
      "box": { "width": "width", "height": "length" },
      "draw": [
        { "closed": true, "path": [[0, 0], ["width", 0], ["width", "length"], [0, "length"]] },
        {
          "repeat": { "count": "width >= 1400 ? 2 : 1" },
          "closed": true,
          "path": [
            ["80 + i * width / 2", 80],
            ["(width >= 1400 ? width / 2 : width) - 80 + i * width / 2", 80],
            ["(width >= 1400 ? width / 2 : width) - 80 + i * width / 2", 460],
            ["80 + i * width / 2", 460]
          ]
        },
        { "path": [[0, 600], ["width", 600]] }
      ]
    },
    {
      "kind": "furn.shelf",
      "category": "furniture",
      "label": "Shelving unit",
      "params": [
        { "key": "length", "label": "Length", "type": "number", "default": 2000, "unit": "length" },
        { "key": "depth", "label": "Depth", "type": "number", "default": 400, "unit": "length" },
        { "key": "bays", "label": "Bays", "type": "number", "default": 4 }
      ],
      "box": { "width": "length", "height": "depth" },
      "draw": [
        { "closed": true, "path": [[0, 0], ["length", 0], ["length", "depth"], [0, "depth"]] },
        { "repeat": { "count": "max(0, bays - 1)" }, "path": [["(i + 1) * length / max(1, bays)", 0], ["(i + 1) * length / max(1, bays)", "depth"]] },
        { "dash": [5, 4], "path": [[0, 0], ["length", "depth"]] }
      ]
    }
  ]
}
